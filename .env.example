# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
APP_NAME=Recorda API
ENVIRONMENT=development
DEBUG=true
VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recorda

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recorda

CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

ACCESS_TOKEN_SECRET_KEY=recorda-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_HASH_ITERATIONS=210000

DEEZER_BASE_URL=https://api.deezer.com
DEEZER_TIMEOUT_SECONDS=5
