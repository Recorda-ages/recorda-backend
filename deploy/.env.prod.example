# Copie para deploy/.env.prod na EC2 e preencha. NUNCA comite o .env.prod.

# Domínio da API (registro A apontando para o Elastic IP da EC2).
# Sem domínio ainda? Use provisoriamente <ip-com-hifens>.sslip.io, ex.: 3-140-12-34.sslip.io
API_DOMAIN=api.seudominio.com

APP_NAME=Recorda API
# production: bloqueia o seed de demonstração. Para carregar os dados de demo uma vez,
# use "staging", rode o seed (ver deploy/README.md) e volte para "production".
ENVIRONMENT=production
DEBUG=false
VERSION=0.1.0

# Endpoint do RDS (aba "Connectivity & security" do banco).
# sslmode=require: o RDS PostgreSQL exige SSL.
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@SEU-ENDPOINT.us-east-2.rds.amazonaws.com:5432/recorda?sslmode=require

# Origens do frontend web que podem chamar a API (separadas por vírgula).
# App mobile nativo não usa CORS.
CORS_ORIGINS=http://localhost:8081

# Obrigatório em produção. Gere com: openssl rand -hex 32
ACCESS_TOKEN_SECRET_KEY=TROQUE-POR-UM-VALOR-ALEATORIO
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_HASH_ITERATIONS=210000

# Senhas dos usuários criados pelo seed de demonstração (troque as padrão).
SEED_USER_PASSWORD=TROQUE-ESTA-SENHA
SEED_ADMIN_PASSWORD=TROQUE-ESTA-SENHA

DEEZER_BASE_URL=https://api.deezer.com
DEEZER_TIMEOUT_SECONDS=5

# Mídias no S3 + CloudFront (usadas quando o código passar a gravar no S3).
# Sem chave de acesso: a API usa as credenciais da IAM role da EC2.
AWS_REGION=us-east-2
S3_BUCKET=recorda-midias-550348326941
CLOUDFRONT_DOMAIN=xxxx.cloudfront.net
